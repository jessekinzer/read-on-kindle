{
  "manifest_version": 3,
  "name": "Read on Kindle",
  "version": "1.0.0",
  "description": "Send any Substack article to your Kindle in one click, including custom-domain newsletters.",
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["storage", "unlimitedStorage", "activeTab", "scripting", "identity"],
  "host_permissions": [
    "https://*.substack.com/*",
    "https://substackcdn.com/*",
    "https://*.substackcdn.com/*",
    "https://substack-post-media.s3.amazonaws.com/*",
    "https://www.googleapis.com/upload/gmail/v1/*"
  ],
  "optional_host_permissions": ["<all_urls>"],
  "oauth2": {
    "client_id": "158487966359-i0h410g6pci951rsreponv7lqph33o39.apps.googleusercontent.com",
    "scopes": ["https://www.googleapis.com/auth/gmail.send"]
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
